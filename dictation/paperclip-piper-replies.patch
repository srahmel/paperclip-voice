+import express from "express";
+import request from "supertest";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { boardMutationGuard } from "../middleware/board-mutation-guard.js";
+import { localSpeechRoutes } from "../routes/local-speech.js";
+
+let directory: string;
+const prior = { python: process.env.PAPERCLIP_TTS_PYTHON, worker: process.env.PAPERCLIP_TTS_WORKER, models: process.env.PAPERCLIP_TTS_MODEL_DIR };
+beforeAll(() => {
+  directory = mkdtempSync(join(tmpdir(), "paperclip-tts-test-"));
+  writeFileSync(join(directory, "worker.cjs"), `process.stdin.resume();process.stdin.on('end',()=>{const b=Buffer.alloc(44);b.write('RIFF',0);b.write('WAVE',8);process.stdout.write(b)});`);
+});
+afterAll(() => {
+  for (const [name, value] of Object.entries({ PAPERCLIP_TTS_PYTHON: prior.python, PAPERCLIP_TTS_WORKER: prior.worker, PAPERCLIP_TTS_MODEL_DIR: prior.models })) {
+    if (value === undefined) delete process.env[name]; else process.env[name] = value;
+  }
+  rmSync(directory, { recursive: true, force: true });
+});
+const company = "company-1";
+const session = { type: "board", source: "session", userId: "u1", companyIds: [company] };
+function app(actor: Record<string, unknown>) {
+  const server = express(); server.use(express.json());
+  server.use((req, _res, next) => { Object.assign(req, { actor }); next(); });
+  server.use(boardMutationGuard()); server.use(localSpeechRoutes());
+  server.use((err: { status?: number }, _req: express.Request, res: express.Response, _next: express.NextFunction) => res.status(err.status ?? 500).json({ error: "denied" }));
+  return server;
+}
+function send(server: express.Express, body = { text: "Hello", language: "de" }) {
+  return request(server).post(`/companies/${company}/local-speech`).set("Origin", "http://localhost:3100").send(body);
+}
+function mockWorker() {
+  process.env.PAPERCLIP_TTS_PYTHON = process.execPath;
+  process.env.PAPERCLIP_TTS_WORKER = join(directory, "worker.cjs");
+  process.env.PAPERCLIP_TTS_MODEL_DIR = directory;
+}
+describe("local speech endpoint", () => {
+  it("rejects unauthenticated, other-company and agent-key requests", async () => {
+    expect((await send(app({ type: "none" }))).status).toBe(401);
+    expect((await send(app({ ...session, companyIds: ["other"] }))).status).toBe(403);
+    expect((await send(app({ type: "agent", companyId: company }))).status).toBe(403);
+    expect((await send(app({ ...session, source: "board_key" }))).status).toBe(403);
+  });
+  it("enforces browser origin and text and language bounds", async () => {
+    expect((await request(app(session)).post(`/companies/${company}/local-speech`).set("Origin", "https://evil.example").send({ text: "a", language: "de" })).status).toBe(403);
+    expect((await send(app(session), { text: "x".repeat(4001), language: "de" })).status).toBe(400);
+    expect((await send(app(session), { text: "a", language: "fr" })).status).toBe(400);
+  });
+  it("returns bounded WAV data without caching", async () => {
+    mockWorker(); const result = await send(app(session));
+    expect(result.status).toBe(200); expect(result.headers["content-type"]).toContain("audio/wav");
+    expect(result.headers["cache-control"]).toBe("no-store"); expect(result.body.subarray(0, 4).toString()).toBe("RIFF");
+  });
+  it("handles a missing worker without exposing local details", async () => {
+    mockWorker(); process.env.PAPERCLIP_TTS_PYTHON = join(directory, "missing.exe");
+    const result = await send(app(session)); expect(result.status).toBe(503); expect(JSON.stringify(result.body)).not.toContain(directory);
+  });
+  it.skipIf(!process.env.PAPERCLIP_TEST_TTS_PYTHON)("synthesizes real local Piper audio through the route", async () => {
+    process.env.PAPERCLIP_TTS_PYTHON = process.env.PAPERCLIP_TEST_TTS_PYTHON;
+    process.env.PAPERCLIP_TTS_WORKER = process.env.PAPERCLIP_TEST_TTS_WORKER;
+    process.env.PAPERCLIP_TTS_MODEL_DIR = process.env.PAPERCLIP_TEST_TTS_MODEL_DIR;
+    const result = await send(app(session), { text: "Dies ist ein Test.", language: "de" });
+    expect(result.status).toBe(200); expect(result.body.length).toBeGreaterThan(1000);
+    expect(result.body.toString("ascii", 0, 4)).toBe("RIFF");
+  }, 90_000);
+});
