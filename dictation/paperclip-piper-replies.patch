diff --git a/server/src/routes/local-speech.ts b/server/src/routes/local-speech.ts
new file mode 100644
index 000000000..55f0b3000
--- /dev/null
+++ b/server/src/routes/local-speech.ts
@@ -0,0 +1,67 @@
+import { Router } from "express";
+import { spawn } from "node:child_process";
+import { assertAuthenticated, assertBoard, assertCompanyAccess } from "./authz.js";
+
+const MAX_WAV = 16 * 1024 * 1024;
+let active = false;
+
+/** Authenticated, bounded, one-shot local TTS; no audio listener or files. */
+export function localSpeechRoutes() {
+  const router = Router();
+  router.post("/companies/:companyId/local-speech", (req, res) => {
+    assertAuthenticated(req);
+    assertBoard(req);
+    assertCompanyAccess(req, req.params.companyId as string);
+    if (req.actor.source !== "session") return res.status(403).json({ error: "A signed-in browser session is required" });
+    res.setHeader("Cache-Control", "no-store");
+    const text = req.body?.text;
+    const language = req.body?.language;
+    if (typeof text !== "string" || !text.trim() || text.length > 4000 || !["de", "en"].includes(language)) {
+      return res.status(400).json({ error: "Invalid speech request" });
+    }
+    const python = process.env.PAPERCLIP_TTS_PYTHON;
+    const worker = process.env.PAPERCLIP_TTS_WORKER;
+    const models = process.env.PAPERCLIP_TTS_MODEL_DIR;
+    if (!python || !worker || !models) return res.status(503).json({ error: "Local speech is unavailable" });
+    if (active) return res.status(429).json({ error: "Local speech is busy" });
+    active = true;
+    const child = spawn(python, [worker], {
+      windowsHide: true,
+      stdio: ["pipe", "pipe", "ignore"],
+      env: {
+        SystemRoot: process.env.SystemRoot, WINDIR: process.env.WINDIR,
+        PATH: process.env.PATH, TEMP: process.env.TEMP, TMP: process.env.TMP,
+        PAPERCLIP_TTS_MODEL_DIR: models, PYTHONNOUSERSITE: "1", PYTHONIOENCODING: "utf-8",
+        HF_HUB_OFFLINE: "1", OMP_NUM_THREADS: "4", OPENBLAS_NUM_THREADS: "1",
+      },
+    });
+    const chunks: Buffer[] = [];
+    let size = 0;
+    let finished = false;
+    const timer = setTimeout(() => child.kill(), 90_000);
+    const finish = (code: number, audio?: Buffer) => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(timer);
+      active = false;
+      if (res.destroyed || res.headersSent) return;
+      if (audio) res.status(200).type("audio/wav").send(audio);
+      else res.status(code).json({ error: "Local speech failed or timed out" });
+    };
+    res.on("close", () => { if (!res.writableFinished) child.kill(); });
+    child.stdout.on("data", (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_WAV) child.kill(); else chunks.push(chunk);
+    });
+    child.stdin.on("error", () => {});
+    child.on("error", () => finish(503));
+    child.on("close", (code) => {
+      if (code !== 0 || size > MAX_WAV) return finish(503);
+      const audio = Buffer.concat(chunks);
+      if (audio.length < 44 || audio.toString("ascii", 0, 4) !== "RIFF" || audio.toString("ascii", 8, 12) !== "WAVE") return finish(503);
+      finish(200, audio);
+    });
+    child.stdin.end(JSON.stringify({ text, language }));
+  });
+  return router;
+}
