+import express from "express";
+import request from "supertest";
+import { mkdtempSync, writeFileSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "vitest";
+import { localDictationRoutes } from "../routes/local-dictation.js";
+import { boardMutationGuard } from "../middleware/board-mutation-guard.js";
+
+const company = "company-1";
+let directory: string;
+const oldEnv = { ...process.env };
+beforeAll(() => {
+  directory = mkdtempSync(join(tmpdir(), "paperclip-dictation-test-"));
+  const fixture = join(directory, "worker.cjs");
+  writeFileSync(fixture, `process.stdin.resume(); process.stdin.on('end', () => { console.log(JSON.stringify({ text: 'hello' })); });`);
+  writeFileSync(join(directory, "slow.cjs"), `process.stdin.resume(); process.stdin.on('end', () => { setTimeout(() => console.log(JSON.stringify({ text: 'hello' })), 700); });`);
+  process.env.PAPERCLIP_VOICE_PYTHON = process.execPath;
+  process.env.PAPERCLIP_VOICE_WORKER = fixture;
+  process.env.PAPERCLIP_VOICE_MODEL = directory;
+});
+afterAll(() => { rmSync(directory, { recursive: true, force: true }); });
+afterEach(() => { for (const k of ["PAPERCLIP_VOICE_PYTHON", "PAPERCLIP_VOICE_WORKER", "PAPERCLIP_VOICE_MODEL"]) { if (oldEnv[k] === undefined) delete process.env[k]; else process.env[k] = oldEnv[k]; } });
+
+function app(actor: Record<string, unknown>) {
+  const server = express();
+  server.use((req, _res, next) => { Object.assign(req, { actor }); next(); });
+  server.use(boardMutationGuard());
+  server.use(localDictationRoutes());
+  server.use((err: { status?: number }, _req: express.Request, res: express.Response, _next: express.NextFunction) => res.status(err.status ?? 500).json({ error: "denied" }));
+  return server;
+}
+const session = { type: "board", source: "session", userId: "u1", companyIds: [company] };
+function send(server: express.Express, bytes: Buffer = Buffer.from("audio")) {
+  return request(server).post(`/companies/${company}/local-dictation`).set("Origin", "http://localhost:3100").set("Content-Type", "audio/webm").send(bytes);
+}
+describe("local dictation endpoint", () => {
+  it("rejects unauthenticated, agent and cross-company requests before accepting audio", async () => {
+    expect((await send(app({ type: "none" }))).status).toBe(401);
+    expect((await send(app({ type: "agent", companyId: company }))).status).toBe(403);
+    expect((await send(app({ ...session, companyIds: ["other"] }))).status).toBe(403);
+  });
+  it("requires a trusted origin and rejects board API keys", async () => {
+    expect((await request(app(session)).post(`/companies/${company}/local-dictation`).set("Origin", "https://evil.example").set("Content-Type", "audio/webm").send("x")).status).toBe(403);
+    expect((await send(app({ ...session, source: "board_key" }))).status).toBe(403);
+  });
+  it("limits uploads and rejects invalid audio types", async () => {
+    expect((await request(app(session)).post(`/companies/${company}/local-dictation`).set("Origin", "http://localhost:3100").set("Content-Type", "text/plain").send("x")).status).toBe(415);
+    expect((await send(app(session), Buffer.alloc(5 * 1024 * 1024 + 1))).status).toBe(413);
+  });
+  it("passes bounded bytes to the worker and returns only its transcript", async () => {
+    process.env.PAPERCLIP_VOICE_PYTHON = process.execPath;
+    process.env.PAPERCLIP_VOICE_WORKER = join(directory, "worker.cjs");
+    process.env.PAPERCLIP_VOICE_MODEL = directory;
+    const res = await send(app(session));
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({ text: "hello" });
+    expect(res.headers["cache-control"]).toBe("no-store");
+  });
+  it("reports an unavailable worker without exposing a process error", async () => {
+    process.env.PAPERCLIP_VOICE_PYTHON = join(directory, "missing.exe");
+    process.env.PAPERCLIP_VOICE_WORKER = join(directory, "worker.cjs");
+    process.env.PAPERCLIP_VOICE_MODEL = directory;
+    const res = await send(app(session));
+    expect(res.status).toBe(503);
+    expect(JSON.stringify(res.body)).not.toContain(directory);
+  });
+  it("rejects parallel uploads while a transcription is running", async () => {
+    process.env.PAPERCLIP_VOICE_PYTHON = process.execPath;
+    process.env.PAPERCLIP_VOICE_WORKER = join(directory, "slow.cjs");
+    process.env.PAPERCLIP_VOICE_MODEL = directory;
+    const server = app(session);
+    const first = send(server).then((result) => result);
+    await new Promise((resolve) => setTimeout(resolve, 250));
+    expect((await send(server)).status).toBe(429);
+    expect((await first).status).toBe(200);
+  });
+  it.skipIf(!process.env.PAPERCLIP_TEST_VOICE_AUDIO)("transcribes a generated speech fixture through the real CPU worker", async () => {
+    process.env.PAPERCLIP_VOICE_PYTHON = process.env.PAPERCLIP_TEST_VOICE_PYTHON;
+    process.env.PAPERCLIP_VOICE_WORKER = process.env.PAPERCLIP_TEST_VOICE_WORKER;
+    process.env.PAPERCLIP_VOICE_MODEL = process.env.PAPERCLIP_TEST_VOICE_MODEL;
+    const response = await request(app(session)).post(`/companies/${company}/local-dictation`)
+      .set("Origin", "http://localhost:3100").set("Content-Type", "audio/wav")
+      .set("X-Dictation-Language", process.env.PAPERCLIP_TEST_VOICE_LANGUAGE ?? "auto")
+      .send(readFileSync(process.env.PAPERCLIP_TEST_VOICE_AUDIO!));
+    expect(response.status).toBe(200);
+    expect(typeof response.body.text).toBe("string");
+    expect(response.body.text.trim().length).toBeGreaterThan(0);
+  }, 180_000);
+});
