diff --git a/server/src/routes/local-dictation.ts b/server/src/routes/local-dictation.ts
new file mode 100644
index 000000000..8982f6c27
--- /dev/null
+++ b/server/src/routes/local-dictation.ts
@@ -0,0 +1,95 @@
+import express, { Router } from "express";
+import { spawn } from "node:child_process";
+import { assertAuthenticated, assertBoard, assertCompanyAccess } from "./authz.js";
+
+const MAX_BYTES = 5 * 1024 * 1024;
+let active: symbol | null = null;
+function release(token: symbol) { if (active === token) active = null; }
+
+/** Audio and output stay in memory. The worker has no network listener. */
+export function localDictationRoutes() {
+  const router = Router();
+  router.post("/companies/:companyId/local-dictation", (req, res, next) => {
+    assertAuthenticated(req);
+    assertBoard(req);
+    assertCompanyAccess(req, req.params.companyId as string);
+    if (req.actor.source !== "session") {
+      res.status(403).json({ error: "A signed-in browser session is required" });
+      return;
+    }
+    res.setHeader("Cache-Control", "no-store");
+    if (!/^audio\/(webm|ogg|mp4|wav|x-wav)(?:;|$)/i.test(req.headers["content-type"] ?? "")) {
+      res.status(415).json({ error: "Unsupported audio format" });
+      return;
+    }
+    if (active) {
+      res.status(429).json({ error: "Local transcription is busy" });
+      return;
+    }
+    const token = Symbol("dictation");
+    active = token;
+    res.locals.dictationToken = token;
+    res.on("close", () => { if (!res.locals.dictationWorkerStarted) release(token); });
+    next();
+  }, express.raw({ type: () => true, limit: MAX_BYTES, inflate: false }), (req, res) => {
+    const language = req.header("X-Dictation-Language") ?? "auto";
+    if (!["auto", "de", "en"].includes(language) || !Buffer.isBuffer(req.body) || !req.body.length) {
+      res.status(400).json({ error: "Invalid audio or language" });
+      return;
+    }
+    const python = process.env.PAPERCLIP_VOICE_PYTHON;
+    const worker = process.env.PAPERCLIP_VOICE_WORKER;
+    if (!python || !worker || !process.env.PAPERCLIP_VOICE_MODEL) {
+      res.status(503).json({ error: "Local transcription is unavailable" });
+      return;
+    }
+    res.locals.dictationWorkerStarted = true;
+    let output = "";
+    let finished = false;
+    const mediaType = (req.headers["content-type"] ?? "").split(";", 1)[0]!.toLowerCase();
+    const format = ({ "audio/webm": "matroska", "audio/ogg": "ogg", "audio/mp4": "mov", "audio/wav": "wav", "audio/x-wav": "wav" } as Record<string, string>)[mediaType]!;
+    const child = spawn(python, [worker, language, format], {
+      windowsHide: true,
+      stdio: ["pipe", "pipe", "ignore"],
+      // Do not pass Paperclip's authentication secrets or agent credentials.
+      env: {
+        SystemRoot: process.env.SystemRoot, WINDIR: process.env.WINDIR,
+        PATH: process.env.PATH, TEMP: process.env.TEMP, TMP: process.env.TMP,
+        PAPERCLIP_VOICE_MODEL: process.env.PAPERCLIP_VOICE_MODEL,
+        PYTHONNOUSERSITE: "1", PYTHONIOENCODING: "utf-8", HF_HUB_OFFLINE: "1",
+        OMP_NUM_THREADS: "4", OPENBLAS_NUM_THREADS: "1",
+      },
+    });
+    const timer = setTimeout(() => { child.kill(); }, 180_000);
+    const finish = (status: number, body: { text?: string; error?: string }) => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(timer);
+      release(res.locals.dictationToken as symbol);
+      if (!res.destroyed && !res.headersSent) res.status(status).json(body);
+    };
+    res.on("close", () => { if (!res.writableFinished) child.kill(); });
+    child.stdout.on("data", (chunk: Buffer) => {
+      output += chunk.toString("utf8");
+      if (output.length > 100_000) child.kill();
+    });
+    child.on("error", () => finish(503, { error: "Local transcription is unavailable" }));
+    child.stdin.on("error", () => {});
+    child.on("close", (code) => {
+      if (code !== 0) return finish(503, { error: "Transcription failed or timed out" });
+      try {
+        const result = JSON.parse(output) as { text?: unknown };
+        if (typeof result.text !== "string" || result.text.length > 50_000) throw new Error();
+        finish(200, { text: result.text });
+      } catch { finish(503, { error: "Transcription failed" }); }
+    });
+    child.stdin.end(req.body);
+  });
+  router.use((err: { status?: number }, _req: express.Request, res: express.Response, next: express.NextFunction) => {
+    if (!res.locals.dictationToken) return next(err);
+    if (!res.locals.dictationWorkerStarted) release(res.locals.dictationToken as symbol);
+    if (res.headersSent) return next(err);
+    res.status(err.status === 413 ? 413 : 400).json({ error: "Invalid or oversized audio" });
+  });
+  return router;
+}
