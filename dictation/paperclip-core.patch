@@ -0,0 +1,125 @@
+import { useEffect, useRef, useState } from "react";
+import { Loader2, Mic, Square, X } from "lucide-react";
+
+type Phase = "idle" | "starting" | "recording" | "processing";
+const MAX_BYTES = 5 * 1024 * 1024;
+
+export function appendDictation(draft: string, text: string) {
+  const clean = text.trim();
+  if (!clean) return draft;
+  return draft + (draft && !/\s$/.test(draft) ? " " : "") + clean;
+}
+
+export function LocalDictation({ companyId, disabled, onText }: {
+  companyId?: string | null; disabled?: boolean; onText: (text: string) => void;
+}) {
+  const [phase, setPhase] = useState<Phase>("idle");
+  const [error, setError] = useState("");
+  const [language, setLanguage] = useState("auto");
+  const phaseRef = useRef<Phase>("idle");
+  const epoch = useRef(0);
+  const stream = useRef<MediaStream | null>(null);
+  const recorder = useRef<MediaRecorder | null>(null);
+  const abort = useRef<AbortController | null>(null);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const onTextRef = useRef(onText);
+  onTextRef.current = onText;
+
+  function transition(next: Phase) { phaseRef.current = next; setPhase(next); }
+  function release() {
+    if (timer.current) clearTimeout(timer.current);
+    timer.current = null;
+    stream.current?.getTracks().forEach((track) => track.stop());
+    stream.current = null;
+  }
+  function cancel() {
+    epoch.current++;
+    abort.current?.abort();
+    abort.current = null;
+    if (recorder.current && recorder.current.state !== "inactive") recorder.current.stop();
+    recorder.current = null;
+    release();
+    transition("idle");
+    setError("");
+  }
+  useEffect(() => () => {
+    epoch.current++;
+    abort.current?.abort();
+    if (recorder.current && recorder.current.state !== "inactive") recorder.current.stop();
+    release();
+  }, []);
+  useEffect(() => { if (disabled) cancel(); }, [disabled]);
+
+  async function toggle() {
+    if (phaseRef.current === "recording") {
+      transition("processing");
+      if (recorder.current?.state === "recording") recorder.current.stop();
+      return;
+    }
+    if (phaseRef.current !== "idle" || !companyId || disabled) return;
+    setError("");
+    transition("starting");
+    const id = ++epoch.current;
+    try {
+      if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") {
+        throw new Error("Mikrofonzugriff benötigt HTTPS oder localhost und einen unterstützten Browser.");
+      }
+      const acquired = await navigator.mediaDevices.getUserMedia({ audio: true });
+      if (id !== epoch.current) { acquired.getTracks().forEach((track) => track.stop()); return; }
+      stream.current = acquired;
+      const mime = ["audio/webm;codecs=opus", "audio/mp4", "audio/ogg;codecs=opus"]
+        .find((value) => MediaRecorder.isTypeSupported(value));
+      const capture = mime ? new MediaRecorder(acquired, { mimeType: mime }) : new MediaRecorder(acquired);
+      recorder.current = capture;
+      const chunks: Blob[] = [];
+      let bytes = 0;
+      capture.ondataavailable = (event) => {
+        if (event.data.size) { bytes += event.data.size; chunks.push(event.data); }
+        if (bytes > MAX_BYTES && capture.state !== "inactive") capture.stop();
+      };
+      capture.onerror = () => { if (id === epoch.current) { cancel(); setError("Aufnahme fehlgeschlagen."); } };
+      capture.onstop = async () => {
+        release();
+        recorder.current = null;
+        if (id !== epoch.current) return;
+        if (!bytes || bytes > MAX_BYTES) { transition("idle"); setError("Aufnahme leer oder zu groß."); return; }
+        transition("processing");
+        const controller = new AbortController();
+        abort.current = controller;
+        const timeout = setTimeout(() => controller.abort(), 185_000);
+        try {
+          const blob = new Blob(chunks, { type: capture.mimeType || "audio/webm" });
+          const response = await fetch(`/api/companies/${encodeURIComponent(companyId)}/local-dictation`, {
+            method: "POST", credentials: "include", cache: "no-store", signal: controller.signal,
+            headers: { "Content-Type": blob.type, "X-Dictation-Language": language }, body: blob,
+          });
+          if (!response.ok) throw new Error("Transkription nicht verfügbar. Bitte erneut versuchen.");
+          const result = await response.json() as { text?: unknown };
+          if (id !== epoch.current) return;
+          if (typeof result.text !== "string" || !result.text.trim()) throw new Error("Keine Sprache erkannt.");
+          onTextRef.current(result.text);
+          transition("idle");
+        } catch (e) {
+          if (id === epoch.current) { transition("idle"); setError(e instanceof Error && e.name !== "AbortError" ? e.message : "Transkription abgebrochen oder Zeitlimit erreicht."); }
+        } finally { clearTimeout(timeout); if (abort.current === controller) abort.current = null; }
+      };
+      capture.start(1000);
+      transition("recording");
+      timer.current = setTimeout(() => { if (capture.state === "recording") capture.stop(); }, 85_000);
+    } catch (e) {
+      release();
+      if (id === epoch.current) { transition("idle"); setError(e instanceof DOMException && e.name === "NotAllowedError" ? "Mikrofonzugriff verweigert." : e instanceof Error ? e.message : "Mikrofon nicht verfügbar."); }
+    }
+  }
+  const active = phase !== "idle";
+  return <span className="inline-flex flex-wrap items-center gap-1 text-xs" data-testid="local-dictation">
+    <button type="button" onClick={() => void toggle()} disabled={disabled || !companyId || phase === "starting" || phase === "processing"}
+      aria-label={phase === "recording" ? "Aufnahme beenden" : "Spracheingabe starten"} title={phase === "recording" ? "Aufnahme beenden" : "Spracheingabe starten"}
+      className="grid size-8 place-items-center rounded-md text-muted-foreground hover:bg-accent disabled:opacity-50">
+      {phase === "recording" ? <Square className="size-4 text-red-600" /> : phase === "processing" || phase === "starting" ? <Loader2 className="size-4 animate-spin" /> : <Mic className="size-4" />}
+    </button>
+    {active ? <><span role="status">{phase === "starting" ? "Mikrofon öffnen…" : phase === "recording" ? "Aufnahme läuft" : "Transkribiere…"}</span><button type="button" onClick={cancel} aria-label="Spracheingabe abbrechen" className="p-1"><X className="size-4" /></button></> :
+      <select aria-label="Sprache der Aufnahme" value={language} onChange={(e) => setLanguage(e.target.value)} className="bg-transparent text-muted-foreground"><option value="auto">Auto</option><option value="de">DE</option><option value="en">EN</option></select>}
+    {error ? <span role="alert" className="text-destructive">{error}</span> : null}
+  </span>;
+}
