index 000000000..0812e18fa
--- /dev/null
+++ b/ui/src/components/VoiceReply.test.tsx
@@ -0,0 +1,72 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { appendVoiceTranscript, useVoiceReply, VoiceReplyControl, VOICE_SHORT_REQUEST } from "./VoiceReply";
+
+(globalThis as unknown as { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+afterEach(() => { vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+
+describe("voice replies", () => {
+  it("keeps the short-answer request visible, editable and present only once", () => {
+    const first = appendVoiceTranscript("Existing", "Hallo");
+    expect(first).toBe(`Existing Hallo\n\n${VOICE_SHORT_REQUEST}`);
+    const second = appendVoiceTranscript(first, "noch etwas");
+    expect(second).toBe(`Existing Hallo noch etwas\n\n${VOICE_SHORT_REQUEST}`);
+  });
+  it("reads only a new agent reply after a dictated draft is submitted, and stops on unmount", async () => {
+    const spoken = vi.fn();
+    const cancel = vi.fn();
+    const localVoice = { localService: true, lang: "de-DE", default: true };
+    Object.defineProperty(window, "speechSynthesis", { configurable: true, value: { getVoices: () => [localVoice], speak: spoken, cancel } });
+    vi.stubGlobal("SpeechSynthesisUtterance", class { text: string; constructor(text: string) { this.text = text; } });
+    const old = { id: "old", body: "Old reply", authorType: "agent", createdAt: new Date() };
+    let voice!: ReturnType<typeof useVoiceReply>;
+    function Harness({ comments }: { comments: typeof old[] }) {
+      voice = useVoiceReply(comments, "thread");
+      return <VoiceReplyControl voice={voice} />;
+    }
+    const container = document.createElement("div");
+    const root = createRoot(container);
+    await act(async () => { root.render(<Harness comments={[old]} />); });
+    expect(spoken).not.toHaveBeenCalled();
+    await act(async () => { voice.markDictated("de"); voice.beforeSubmit("My message"); });
+    await act(async () => { root.render(<Harness comments={[old, { id: "human", body: "message", authorType: "user", createdAt: new Date() }]} />); });
+    expect(spoken).not.toHaveBeenCalled();
+    await act(async () => { root.render(<Harness comments={[old, { id: "new", body: "Kurze Antwort.", authorType: "agent", createdAt: new Date() }]} />); });
+    expect(spoken).toHaveBeenCalledTimes(1);
+    expect(spoken.mock.calls[0]![0].text).toBe("Kurze Antwort.");
+    expect(spoken.mock.calls[0]![0].voice).toBe(localVoice);
+    await act(async () => root.unmount());
+    expect(cancel).toHaveBeenCalledTimes(1);
+  });
+  it("does not use remote voices and shows an actionable error", async () => {
+    const spoken = vi.fn();
+    Object.defineProperty(window, "speechSynthesis", { configurable: true, value: { getVoices: () => [{ localService: false, lang: "de-DE" }], speak: spoken, cancel: vi.fn() } });
+    vi.stubGlobal("SpeechSynthesisUtterance", class {});
+    let voice!: ReturnType<typeof useVoiceReply>;
+    function Harness() { voice = useVoiceReply([], "thread"); return <VoiceReplyControl voice={voice} />; }
+    const container = document.createElement("div");
+    const root = createRoot(container);
+    await act(async () => { root.render(<Harness />); });
+    await act(async () => { voice.speak("Hallo"); });
+    expect(spoken).not.toHaveBeenCalled();
+    expect(container.textContent).toContain("Keine lokale Stimme");
+    await act(async () => root.unmount());
+  });
+  it("does not arm after the user disables output", async () => {
+    const spoken = vi.fn();
+    Object.defineProperty(window, "speechSynthesis", { configurable: true, value: { getVoices: () => [{ localService: true, lang: "de-DE" }], speak: spoken, cancel: vi.fn() } });
+    vi.stubGlobal("SpeechSynthesisUtterance", class {});
+    let voice!: ReturnType<typeof useVoiceReply>;
+    function Harness({ comments }: { comments: { id: string; body: string; authorType: string; createdAt: Date }[] }) {
+      voice = useVoiceReply(comments, "thread"); return <VoiceReplyControl voice={voice} />;
+    }
+    const container = document.createElement("div"); const root = createRoot(container);
+    await act(async () => { root.render(<Harness comments={[]} />); });
+    await act(async () => { voice.toggle(); voice.markDictated("de"); voice.beforeSubmit("message"); });
+    await act(async () => { root.render(<Harness comments={[{ id: "new", body: "reply", authorType: "agent", createdAt: new Date() }]} />); });
+    expect(spoken).not.toHaveBeenCalled();
+    await act(async () => root.unmount());
+  });
+});
diff --git a/ui/src/components/VoiceReply.tsx b/ui/src/components/VoiceReply.tsx
new file mode 100644
index 000000000..35526303c
--- /dev/null
+++ b/ui/src/components/VoiceReply.tsx
@@ -0,0 +1,124 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Volume2, VolumeX } from "lucide-react";
+
+export const VOICE_SHORT_REQUEST = "[Sprachmodus: Bitte antworte möglichst in ein bis drei kurzen, gut vorlesbaren Sätzen. Wichtige Details und Arbeitsergebnisse weiterhin vollständig dokumentieren.]";
+
+export function appendVoiceTranscript(draft: string, text: string) {
+  const clean = text.trim();
+  if (!clean) return draft;
+  const hasSuffix = draft.trimEnd().endsWith(VOICE_SHORT_REQUEST);
+  const base = hasSuffix ? draft.trimEnd().slice(0, -VOICE_SHORT_REQUEST.length).trimEnd() : draft;
+  return `${base}${base && !/\s$/.test(base) ? " " : ""}${clean}\n\n${VOICE_SHORT_REQUEST}`;
+}
+
+type Comment = {
+  id: string; body: string; authorType?: string | null; authorAgentId?: string | null;
+  authorUserId?: string | null;
+  derivedAuthorAgentId?: string | null; deletedAt?: Date | string | null;
+  createdAt: Date | string; presentation?: { kind?: string } | null;
+};
+
+export function spokenReplyText(text: string) {
+  return text.replace(/```[\s\S]*?```/g, " Code steht im Chat. ")
+    .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
+    .replace(/https?:\/\/\S+/g, " Link im Chat ")
+    .replace(/^\s*#{1,6}\s*/gm, "").replace(/[\*_`~]/g, "")
+    .replace(/\s+/g, " ").trim();
+}
+
+export function useVoiceReply(comments: readonly Comment[], contextKey: string | null | undefined) {
+  const [enabled, setEnabled] = useState(true);
+  const [status, setStatus] = useState("");
+  const [lastText, setLastText] = useState("");
+  const enabledRef = useRef(true);
+  const commentsRef = useRef(comments);
+  commentsRef.current = comments;
+  const pending = useRef(false);
+  const language = useRef("de");
+  const armed = useRef<{ seen: Set<string>; since: number } | null>(null);
+  const speaking = useRef(false);
+  const epoch = useRef(0);
+
+  const stop = useCallback(() => {
+    epoch.current++;
+    if (speaking.current && typeof window !== "undefined" && window.speechSynthesis) window.speechSynthesis.cancel();
+    speaking.current = false;
+  }, []);
+  const speak = useCallback((raw: string) => {
+    const text = spokenReplyText(raw);
+    if (!text) return;
+    setLastText(text);
+    const synth = window.speechSynthesis;
+    if (!synth || typeof SpeechSynthesisUtterance === "undefined") { setStatus("Sprachausgabe in diesem Browser nicht verfügbar."); return; }
+    let voices: SpeechSynthesisVoice[];
+    try { voices = synth.getVoices(); } catch { setStatus("Sprachausgabe nicht verfügbar."); return; }
+    const local = voices.filter((voice) => voice.localService && voice.lang.toLowerCase().startsWith(language.current));
+    if (!local.length) { setStatus("Keine lokale Stimme gefunden. Prüfe die Spracheinstellungen deines Geräts."); return; }
+    stop();
+    const id = epoch.current;
+    // Short utterances avoid browser limits while retaining the entire response.
+    const parts = text.match(/.{1,200}(?:\s|$)|\S{1,200}/g) ?? [text];
+    speaking.current = true;
+    setStatus("Antwort wird vorgelesen.");
+    try {
+      parts.forEach((part, index) => {
+        const utterance = new SpeechSynthesisUtterance(part.trim());
+        utterance.voice = local.find((voice) => voice.default) ?? local[0]!;
+        utterance.lang = utterance.voice.lang;
+        utterance.onerror = () => { if (epoch.current === id) { stop(); setStatus("Vorlesen fehlgeschlagen. Du kannst es erneut versuchen."); } };
+        utterance.onend = () => { if (epoch.current === id && index === parts.length - 1) { speaking.current = false; setStatus(""); } };
+        synth.speak(utterance);
+      });
+    } catch { stop(); setStatus("Vorlesen fehlgeschlagen. Du kannst es erneut versuchen."); }
+  }, [stop]);
+
+  const markDictated = useCallback((selectedLanguage: string) => {
+    pending.current = true;
+    language.current = selectedLanguage === "en" ? "en" : "de";
+  }, []);
+  const beginDictation = useCallback(() => { armed.current = null; pending.current = false; stop(); setStatus(""); }, [stop]);
+  const beforeSubmit = useCallback((body: string) => {
+    if (!enabledRef.current || (!pending.current && !body.includes(VOICE_SHORT_REQUEST))) return;
+    pending.current = false;
+    armed.current = { seen: new Set(commentsRef.current.map((comment) => comment.id)), since: Date.now() - 1000 };
+    setStatus("Warte auf die Agentenantwort.");
+  }, []);
+  const submitFailed = useCallback(() => { armed.current = null; setStatus(""); }, []);
+  const stopPlayback = useCallback(() => { stop(); setStatus(""); }, [stop]);
+  const toggle = useCallback(() => {
+    enabledRef.current = !enabledRef.current;
+    setEnabled(enabledRef.current);
+    if (!enabledRef.current) { armed.current = null; stop(); setStatus(""); }
+  }, [stop]);
+
+  useEffect(() => {
+    const waiting = armed.current;
+    if (!waiting || !enabledRef.current) return;
+    const response = comments.find((comment) => !waiting.seen.has(comment.id) && !comment.deletedAt &&
+      comment.authorType !== "system" && comment.presentation?.kind !== "system_notice" &&
+      (comment.authorType === "agent" || comment.authorAgentId || comment.derivedAuthorAgentId || comment.authorUserId === "board-concierge") &&
+      new Date(comment.createdAt).getTime() >= waiting.since && comment.body?.trim());
+    if (response) { armed.current = null; speak(response.body); }
+  }, [comments, speak]);
+  useEffect(() => () => { armed.current = null; pending.current = false; stop(); }, [contextKey, stop]);
+  const latestReply = useMemo(() => comments.filter((comment) => !comment.deletedAt && comment.authorType !== "system" &&
+    comment.presentation?.kind !== "system_notice" &&
+    (comment.authorType === "agent" || comment.authorAgentId || comment.derivedAuthorAgentId || comment.authorUserId === "board-concierge") && comment.body?.trim())
+    .reduce<Comment | undefined>((latest, comment) => !latest || new Date(comment.createdAt).getTime() > new Date(latest.createdAt).getTime() ? comment : latest, undefined), [comments]);
+  return { enabled, status, lastText, latestReply: latestReply?.body ?? "", toggle, stop: stopPlayback, speak, beginDictation, markDictated, beforeSubmit, submitFailed };
+}
+
+export function VoiceReplyControl({ voice }: { voice: ReturnType<typeof useVoiceReply> }) {
+  return <span className="inline-flex items-center gap-1 text-xs text-muted-foreground">
+    <button type="button" onClick={voice.toggle} aria-label={voice.enabled ? "Antwort vorlesen ausschalten" : "Antwort vorlesen einschalten"}
+      title={voice.enabled ? "Antwort vorlesen: an" : "Antwort vorlesen: aus"} className="grid size-8 place-items-center rounded-md hover:bg-accent">
+      {voice.enabled ? <Volume2 className="size-4" /> : <VolumeX className="size-4" />}
+    </button>
+    {voice.latestReply ? <button type="button" onClick={() => voice.speak(voice.latestReply)} className="hover:underline">Letzte Antwort vorlesen</button> : null}
+    {voice.status ? <span role="status">{voice.status}</span> : null}
+    {voice.status.includes("vorgelesen") ? <button type="button" onClick={voice.stop}>Stopp</button> : null}
+    {voice.lastText && (voice.status.includes("fehlgeschlagen") || voice.status.includes("Keine lokale Stimme")) ?
+      <button type="button" onClick={() => voice.speak(voice.lastText)}>Erneut vorlesen</button> : null}
+  </span>;
+}
