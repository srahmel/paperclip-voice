{
  "name": "paperclip-plugin-voice",
  "version": "0.3.4",
  "private": true,
  "description": "Local voice control of existing Paperclip chats and issues with Whisper, Piper and optional Moonshine streaming.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "keywords": ["paperclip", "paperclip-plugin", "voice", "whisper", "piper", "tts", "stt"],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "files": ["dist", "README.md", "LICENSE", "docs", "dictation/transcribe.py", "dictation/synthesize.py", "dictation/stream-transcribe.py", "dictation/requirements.txt", "dictation/requirements-tts.txt", "dictation/requirements-streaming.txt"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.1023.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  }
}
